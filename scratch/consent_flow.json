{
  "version": "6.1",
  "routing_model": {
    "CONSENT_SCREEN": []
  },
  "screens": [
    {
      "id": "CONSENT_SCREEN",
      "title": "Consent Form",
      "terminal": true,
      "data": {
        "patient_name": { "type": "string", "__default__": "" },
        "contact_number": { "type": "string", "__default__": "" },
        "service_category": { "type": "string", "__default__": "Elderly Care" },
        "offered_time": { "type": "string", "__default__": "10 Hours" },
        "service_start_date": { "type": "string", "__default__": "" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          { "type": "TextHeading", "text": "Patient Details" },
          { "type": "TextInput", "name": "relative_name", "label": "Relative Name", "required": true },
          { "type": "TextInput", "name": "patient_name", "label": "Patient Name", "init-value": "${data.patient_name}", "required": true },
          { "type": "TextInput", "name": "age", "label": "Age", "input-type": "number", "required": true },
          { "type": "TextInput", "name": "weight", "label": "Weight (kg)", "input-type": "number", "required": true },
          { "type": "TextInput", "name": "contact_number", "label": "Contact Number (10 digits)", "input-type": "phone", "init-value": "${data.contact_number}", "required": true, "regex-match": "^[0-9]{10}$", "error-message": "Please enter exactly 10 digits" },
          { "type": "TextInput", "name": "alternate_contact_number", "label": "Alt. Contact", "input-type": "phone", "required": true, "regex-match": "^[0-9]{10}$", "error-message": "Please enter exactly 10 digits" },
          
          { "type": "TextHeading", "text": "Care Requirements" },
          { "type": "TextInput", "name": "address", "label": "Resident Address", "required": true },
          { "type": "TextInput", "name": "reference_by", "label": "Reference By", "required": true },
          { "type": "CalendarPicker", "name": "service_start_date", "label": "Service Start Date", "init-value": "${data.service_start_date}", "required": true },
          { "type": "Dropdown", "name": "service_category", "label": "Service Category", "init-value": "${data.service_category}", "required": true, "data-source": [
              {"id": "Elderly Care", "title": "Elderly Care"},
              {"id": "Baby Care", "title": "Baby Care"},
              {"id": "Patient Care", "title": "Patient Care"},
              {"id": "Nursing", "title": "Nursing"},
              {"id": "Other", "title": "Other"}
          ]},
          { "type": "Dropdown", "name": "offered_time", "label": "Offered Time", "init-value": "${data.offered_time}", "required": true, "data-source": [
              {"id": "10 Hours", "title": "10 Hours"},
              {"id": "24 Hours (Live-in)", "title": "24 Hours (Live-in)"},
              {"id": "Other", "title": "Other"}
          ]},
          { "type": "TextArea", "name": "other_details", "label": "Details (if 'Other')", "required": false },
          
          { "type": "TextHeading", "text": "Declaration" },
          { "type": "TextBody", "text": "99CARE is for provide skilled based and trained staffs as per requirements. Inception by head nurse and she will confirmed about patients conditions about to provide care taker. and then after patient's guardian has to confirmed about details and regulation shared from our side. Therefore this form is give consent for the services which you looking for.\n\nI confirmed that Inform individuals about the activity or procedure, Ensuring that understand the potential risks and benefits, I agreed that obtained their voluntary Protected the individual's rights and autonomy.\n\n1. The care taker provided by us will only do all the work as per the information provided by the company and before giving any other work, please inform the company.\n2. You are requested to pay us the sum of the payment time as per the agreed time.\n3. This form is mandatory to ensure that all the information is maintained and our service can. be improved further.\n4. So that the staff sent by us can give you better work, you should tell us the mistakes made by them and talk to them with respect.\n5. If the work is done more than the given time, they will be paid as overtime.\n6. If the staff works 24 hours, please provide them with tea and food in the morning and evening as per the time.\n7. If the care taker is appointed, the payment date will be calculated as per the day starting from that day." },
          { "type": "OptIn", "name": "terms_accepted", "label": "I confirm and agree to terms.", "required": true },
          { "type": "Footer", "label": "Submit Form", "on-click-action": { "name": "complete", "payload": { 
              "relative_name": "${form.relative_name}",
              "patient_name": "${form.patient_name}",
              "age": "${form.age}",
              "weight": "${form.weight}",
              "contact_number": "${form.contact_number}",
              "alternate_contact_number": "${form.alternate_contact_number}",
              "address": "${form.address}",
              "reference_by": "${form.reference_by}",
              "service_start_date": "${form.service_start_date}",
              "service_category": "${form.service_category}",
              "offered_time": "${form.offered_time}",
              "other_details": "${form.other_details}",
              "terms_accepted": "${form.terms_accepted}",
              "flow_type": "consent_form"
           } } }
        ]
      }
    }
  ]
}
